{
  "schema": "remora-install-modules/v1",
  "modules": {
    "mpstat": {
      "default": "on",
      "kind": "third_party",
      "requires": [],
      "artifacts": [
        "bin/mpstat"
      ],
      "third_party_package": "mpstat"
    },
    "cpu": {
      "default": "on",
      "kind": "collector",
      "requires": [
        "mpstat"
      ],
      "entry": "cpu,CPU"
    },
    "memory": {
      "default": "on",
      "kind": "collector",
      "requires": [],
      "entry": "memory,MEMORY"
    },
    "numa": {
      "default": "auto",
      "kind": "collector",
      "requires": [],
      "entry": "numa,NUMA"
    },
    "eth": {
      "default": "auto",
      "kind": "collector",
      "requires": [],
      "entry": "eth,NETWORK"
    },
    "ib": {
      "default": "auto",
      "kind": "collector",
      "requires": [],
      "entry": "ib,NETWORK"
    },
    "opa": {
      "default": "off",
      "kind": "collector",
      "requires": [],
      "entry": "opa,NETWORK"
    },
    "power": {
      "default": "auto",
      "kind": "collector",
      "requires": [],
      "entry": "power,POWER"
    },
    "temperature": {
      "default": "auto",
      "kind": "collector",
      "requires": [],
      "entry": "temperature,TEMPERATURE"
    },
    "gpu": {
      "default": "auto",
      "kind": "nvml",
      "requires": [],
      "entry": "gpu,MEMORY",
      "artifacts": [
        "bin/binary_data_collectors/data_collect_gpu"
      ]
    },
    "mpip": {
      "default": "auto",
      "kind": "third_party",
      "requires": [],
      "entry": "impi_mpip,MPI",
      "artifacts": [
        "lib/libmpiP.a",
        "lib/libmpiP.so"
      ],
      "third_party_package": "mpip"
    },
    "network": {
      "default": "auto",
      "kind": "shell",
      "requires": [],
      "entry": "network,NETWORK"
    },
    "lustre": {
      "default": "off",
      "kind": "shell",
      "requires": [],
      "entry": "lustre,IO"
    },
    "lnet": {
      "default": "off",
      "kind": "shell",
      "requires": [],
      "entry": "lnet,IO"
    },
    "io": {
      "default": "off",
      "kind": "collector",
      "requires": [],
      "entry": "io,IO",
      "artifacts": [
        "bin/binary_data_collectors/data_collect_io"
      ]
    },
    "dvs": {
      "default": "off",
      "kind": "shell",
      "requires": [],
      "entry": "dvs,IO"
    },
    "netinfo": {
      "default": "off",
      "kind": "collector",
      "requires": [],
      "entry": "netinfo,NETWORK"
    },
    "neterrors": {
      "default": "off",
      "kind": "collector",
      "requires": [],
      "entry": "neterrors,NETWORK"
    },
    "ibcounters": {
      "default": "off",
      "kind": "collector",
      "requires": [],
      "entry": "ibcounters,NETWORK"
    },
    "mlxcounters": {
      "default": "off",
      "kind": "collector",
      "requires": [],
      "entry": "mlxcounters,NETWORK"
    },
    "opacounters": {
      "default": "off",
      "kind": "collector",
      "requires": [],
      "entry": "opacounters,NETWORK"
    },
    "netprotocol": {
      "default": "off",
      "kind": "collector",
      "requires": [],
      "entry": "netprotocol,NETWORK"
    },
    "softnet": {
      "default": "off",
      "kind": "collector",
      "requires": [],
      "entry": "softnet,NETWORK"
    }
  }
}
