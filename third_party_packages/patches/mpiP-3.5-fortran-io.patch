--- a/mpiPi.c
+++ b/mpiPi.c
@@ -18,6 +18,32 @@
 #include <float.h>
 #include <unistd.h>
 #include "mpiPi.h"
+
+#ifndef ENABLE_API_ONLY
+#include "symbols.h"
+extern void F77_MPIPI_INIT_FORTRAN_SENTINELS (void);
+static void *mpiPi_f_in_place;
+static void *mpiPi_f_bottom;
+
+void
+F77_MPIPI_REGISTER_FORTRAN_SENTINELS (void *in_place, void *bottom)
+{
+  mpiPi_f_in_place = in_place;
+  mpiPi_f_bottom = bottom;
+}
+
+/* Translate addresses, never dereference a user's choice buffer. */
+void *
+mpiPi_fortran_buffer (const void *buffer)
+{
+  if (buffer == mpiPi_f_in_place)
+    return MPI_IN_PLACE;
+  if (buffer == mpiPi_f_bottom)
+    return MPI_BOTTOM;
+  return (void *) buffer;
+}
+#endif
+
 
 
 
