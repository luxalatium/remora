recursive subroutine mpip_f08_alltoall(sendbuf,sendcount,sendtype,recvbuf,recvcount,recvtype,comm, &
    & ierror)
  use mpip_f08_support
  implicit none
  type(*), dimension(@BUFFER@), asynchronous :: sendbuf,recvbuf
  integer :: sendcount,recvcount
  type(MPI_Datatype) :: sendtype,recvtype
  type(MPI_Comm) :: comm
  integer, optional :: ierror
  integer :: err
  type(c_ptr) :: token
  real(c_double) :: mess,io,rma
  mess=payload(sendtype,sendcount) * comm_size(comm)
  io=0.0_c_double
  rma=0.0_c_double
  token=f08_begin("MPI_Alltoall"//c_null_char)
  call PMPI_Alltoall(sendbuf,sendcount,sendtype,recvbuf,recvcount,recvtype,comm,err)
  call f08_end(token,mess,io,rma)
  if (present(ierror)) ierror=err
end subroutine

