! Native MPI F08 wrappers: compiler owns descriptors, handles and statuses.
module mpip_f08_support
  use iso_c_binding
  use mpi_f08
  implicit none
  interface
    function f08_begin(name) bind(C,name="mpip_f08_begin") result(token)
      import c_char,c_ptr
      character(kind=c_char) :: name(*)
      type(c_ptr) :: token
    end function
    subroutine f08_end(token,mess,io,rma) bind(C,name="mpip_f08_end")
      import c_ptr,c_double
      type(c_ptr),value :: token
      real(c_double),value :: mess,io,rma
    end subroutine
  end interface
contains
  recursive function payload(datatype,count) result(bytes)
    type(MPI_Datatype) :: datatype
    integer :: count,tsize,err
    real(c_double) :: bytes
    call PMPI_Type_size(datatype,tsize,err)
    bytes=0.0_c_double
    if (err==MPI_SUCCESS .and. count>=0) bytes=real(tsize,c_double)*real(count,c_double)
  end function
  recursive function comm_size(comm) result(n)
    type(MPI_Comm) :: comm
    integer :: count,err
    real(c_double) :: n
    call PMPI_Comm_size(comm,count,err)
    n=0.0_c_double
    if (err==MPI_SUCCESS) n=real(count,c_double)
  end function
end module

recursive subroutine mpip_f08_barrier(comm,ierror)
  use mpip_f08_support
  implicit none
  type(MPI_Comm) :: comm
  integer, optional :: ierror
  integer :: err
  type(c_ptr) :: token
  real(c_double) :: mess,io,rma
  mess=0.0_c_double
  io=0.0_c_double
  rma=0.0_c_double
  token=f08_begin("MPI_Barrier"//c_null_char)
  call PMPI_Barrier(comm,err)
  call f08_end(token,mess,io,rma)
  if (present(ierror)) ierror=err
end subroutine

recursive subroutine mpip_f08_send(buf,count,datatype,dest,tag,comm,ierror)
  use mpip_f08_support
  implicit none
  type(*), dimension(@BUFFER@), asynchronous :: buf
  integer :: count,dest,tag
  type(MPI_Datatype) :: datatype
  type(MPI_Comm) :: comm
  integer, optional :: ierror
  integer :: err
  type(c_ptr) :: token
  real(c_double) :: mess,io,rma
  mess=payload(datatype,count)
  io=0.0_c_double
  rma=0.0_c_double
  token=f08_begin("MPI_Send"//c_null_char)
  call PMPI_Send(buf,count,datatype,dest,tag,comm,err)
  call f08_end(token,mess,io,rma)
  if (present(ierror)) ierror=err
end subroutine

