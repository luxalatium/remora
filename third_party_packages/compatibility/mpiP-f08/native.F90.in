  call PMPI_Win_free(win,err)
  call f08_end(token,mess,io,rma)
  if (present(ierror)) ierror=err
end subroutine

recursive subroutine mpip_f08_put(origin_addr,origin_count,origin_datatype,target_rank,target_disp, &
    & target_count,target_datatype,win,ierror)
  use mpip_f08_support
  implicit none
  type(*), dimension(@BUFFER@), asynchronous :: origin_addr
  integer :: origin_count,target_rank,target_count
  integer(kind=MPI_ADDRESS_KIND) :: target_disp
  type(MPI_Datatype) :: origin_datatype,target_datatype
  type(MPI_Win) :: win
  integer, optional :: ierror
  integer :: err
  type(c_ptr) :: token
  real(c_double) :: mess,io,rma
  mess=0.0_c_double
  io=0.0_c_double
  rma=payload(target_datatype,target_count)
  token=f08_begin("MPI_Put"//c_null_char)
  call PMPI_Put(origin_addr,origin_count,origin_datatype,target_rank,target_disp,target_count, &
    & target_datatype,win,err)
  call f08_end(token,mess,io,rma)
  if (present(ierror)) ierror=err
end subroutine
